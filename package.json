{
  "name": "@gatopago/protocol",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "contracts:install": "cd contracts && forge install --no-git --shallow forge-std=foundry-rs/forge-std@bf647bd6046f2f7da30d0c2bf435e5c76a780c1b openzeppelin-contracts=OpenZeppelin/openzeppelin-contracts@cab19933c33c2ad1d4c7a84864a3601dddfd16f3 account-abstraction=eth-infinitism/account-abstraction@b36a1ed52ae00da6f8a4c8d50181e2877e4fa410",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "build": "node scripts/build-sdk.mjs",
    "test": "vitest run",
    "pack": "pnpm build && pnpm --dir packages/shared pack --pack-destination ../../output",
    "format": "prettier --write packages scripts test",
    "format:check": "prettier --check packages scripts test"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "17.2.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "viem": "2.55.19",
    "vitest": "4.1.11"
  }
}
