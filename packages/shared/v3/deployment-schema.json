{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gatopago.com/schemas/v3/deployment-1.json",
  "definitions": {
    "hash": { "$ref": "https://gatopago.com/schemas/v3/wire-1.json#/definitions/bytes32" },
    "address": { "$ref": "https://gatopago.com/schemas/v3/wire-1.json#/definitions/address" },
    "compiler": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "optimizer_runs", "via_ir", "evm_version"],
      "properties": {
        "version": { "type": "string", "pattern": "^0\\.8\\.[0-9]{1,3}$(?![\\s\\S])" },
        "optimizer_runs": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "via_ir": { "type": "boolean" },
        "evm_version": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,31}$(?![\\s\\S])" }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "deployer", "salt", "creation_code_hash", "runtime_code_hash", "abi_sha256", "source_commit", "source_tree_sha256", "dependency_lock_sha256", "build_info_sha256", "compiler", "deployment_tx", "deployed_block", "verification_url"],
      "properties": {
        "address": { "$ref": "#/definitions/address" },
        "deployer": { "$ref": "#/definitions/address" },
        "salt": { "anyOf": [{ "$ref": "#/definitions/hash" }, { "type": "null" }] },
        "creation_code_hash": { "$ref": "#/definitions/hash" },
        "runtime_code_hash": { "$ref": "#/definitions/hash" },
        "abi_sha256": { "$ref": "#/definitions/hash" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])" },
        "source_tree_sha256": { "$ref": "#/definitions/hash" },
        "dependency_lock_sha256": { "$ref": "#/definitions/hash" },
        "build_info_sha256": { "$ref": "#/definitions/hash" },
        "compiler": { "$ref": "#/definitions/compiler" },
        "deployment_tx": { "$ref": "#/definitions/hash" },
        "deployed_block": { "$ref": "https://gatopago.com/schemas/v3/wire-1.json#/definitions/atomicAmount" },
        "verification_url": { "type": ["string", "null"] }
      }
    },
    "creation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "purpose", "deployment", "proxy_creation_code", "webauthn_verifier", "entry_point_code_hash", "sender_creator"],
      "properties": {
        "schema_version": { "const": 1 },
        "purpose": { "const": "account_creation" },
        "deployment": { "$ref": "#/definitions/manifest" },
        "proxy_creation_code": { "type": "string", "pattern": "^0x(?:[0-9a-f]{2}){1,16000}$(?![\\s\\S])" },
        "webauthn_verifier": { "$ref": "#/definitions/component" },
        "entry_point_code_hash": { "$ref": "#/definitions/hash" },
        "sender_creator": {
          "type": "object", "additionalProperties": false, "required": ["address", "runtime_code_hash"],
          "properties": { "address": { "$ref": "#/definitions/address" }, "runtime_code_hash": { "$ref": "#/definitions/hash" } }
        }
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "generation", "manifest_id", "network_id", "genesis_hash", "lifecycle_status", "entry_point", "proxy", "components", "storage_layout_hash"],
      "properties": {
        "schema_version": { "const": 1 },
        "generation": { "const": 3 },
        "manifest_id": { "$ref": "https://gatopago.com/schemas/v3/wire-1.json#/definitions/uuid" },
        "network_id": { "$ref": "https://gatopago.com/schemas/v3/wire-1.json#/definitions/evmNetworkId" },
        "genesis_hash": { "$ref": "#/definitions/hash" },
        "lifecycle_status": { "enum": ["candidate", "deployed", "retired"] },
        "entry_point": { "$ref": "#/definitions/address" },
        "storage_layout_hash": { "$ref": "#/definitions/hash" },
        "proxy": {
          "type": "object", "additionalProperties": false,
          "required": ["runtime_code_hash", "init_code_hash", "artifact_sha256"],
          "properties": {
            "runtime_code_hash": { "$ref": "#/definitions/hash" },
            "init_code_hash": { "$ref": "#/definitions/hash" },
            "artifact_sha256": { "$ref": "#/definitions/hash" }
          }
        },
        "components": {
          "type": "object", "additionalProperties": false,
          "required": ["factory", "implementation", "security_module", "upgrade_module"],
          "properties": {
            "factory": { "$ref": "#/definitions/component" },
            "implementation": { "$ref": "#/definitions/component" },
            "security_module": { "$ref": "#/definitions/component" },
            "upgrade_module": { "$ref": "#/definitions/component" }
          }
        }
      }
    }
  }
}
