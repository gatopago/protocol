# Variables the deployment scripts read. Never put a private key here: sign with Foundry's
# --account (keystore). Pass the network with --rpc-url (public RPCs of the testnets:
# https://sepolia-rollup.arbitrum.io/rpc, https://api.avax-test.network/ext/bc/C/rpc,
# https://testnet-rpc.monad.xyz).

# Wallet (script/DeployWallet.s.sol). Both addresses are part of the paymaster's CREATE2 address:
# keep them identical on every network. The owner can withdraw the deposit: use a cold key.
GATOPAGO_SPONSOR_SIGNER=0x0000000000000000000000000000000000000000
GATOPAGO_PAYMASTER_OWNER=0x0000000000000000000000000000000000000000
# Optional: wei deposited into the EntryPoint for the paymaster (default 0).
GATOPAGO_PAYMASTER_DEPOSIT=0

# Flow's payment router (script/DeployPayments.s.sol): who administers it, who signs payment
# intents, and where payments settle.
GATOPAGO_PAYMENTS_OWNER=0x0000000000000000000000000000000000000000
GATOPAGO_PAYMENTS_SIGNER=0x0000000000000000000000000000000000000000
GATOPAGO_PAYMENTS_TREASURY=0x0000000000000000000000000000000000000000
